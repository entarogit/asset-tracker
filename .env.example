# Google OAuth 설정
# Google Cloud Console에서 발급받은 값을 입력하세요
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 세션 암호화 키 (랜덤 문자열로 변경하세요)
SECRET_KEY=change-this-to-a-random-secret-key

# Google OAuth 리디렉션 URI
# 로컬: http://localhost:8080/auth/callback
# Vercel: https://your-app.vercel.app/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback

# 데이터베이스 URL
# 로컬: 설정 불필요 (SQLite 자동 사용)
# Vercel: 대시보드 Storage 탭 → Vercel Postgres 추가 시 자동 주입됨
# DATABASE_URL=postgresql://user:password@host/dbname

# 로컬 개발 환경에서 HTTP 허용 (배포 시 제거)
OAUTHLIB_INSECURE_TRANSPORT=1
